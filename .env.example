# Required for chain mode and rpc mode
MAIN_PRIVATE_KEY=

# Optional (these will be randomly generated if not provided) (For chain mode only)
BATCH_POSTER_PRIVATE_KEY=
VALIDATOR_PRIVATE_KEY=

# Required for rpc mode, optional for chain mode
CHAIN_DEPLOYMENT_TRANSACTION_HASH=

# Parent chain identifier (default: arbitrum-sepolia)
# Supported: arbitrum-sepolia, arbitrum, arbitrum-nova, ethereum, sepolia, base, base-sepolia
PARENT_CHAIN=arbitrum-sepolia

# RPC endpoint for the parent chain. Must match the PARENT_CHAIN setting.
PARENT_CHAIN_RPC=

# Required for chain mode
CHAIN_RPC=http://localhost:8449

