{
  "name": "arbitrum-chain-playbook",
  "version": "1.0.0",
  "description": "An interactive command line tool for Arbitrum chain operations and playbooks",
  "homepage": "https://github.com/offchainlabs/arbitrum-chain-playbook#readme",
  "bugs": {
    "url": "https://github.com/offchainlabs/arbitrum-chain-playbook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offchainlabs/arbitrum-chain-playbook.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc && mkdir -p dist/playbooks/timeboost/artifacts && cp src/playbooks/timeboost/artifacts/*.json dist/playbooks/timeboost/artifacts/",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test \"tests/unit/**/*.spec.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "run:script": "tsx src/scripted/runScript.ts",
    "gen:bid-token": "tsx scripts/genBidTokenArtifact.ts"
  },
  "dependencies": {
    "@arbitrum/chain-sdk": "^v0.25.3",
    "@arbitrum/nitro-contracts": "^3.2.0",
    "@arbitrum/sdk": "^4.0.4",
    "@openzeppelin/contracts": "^5.4.0",
    "chalk": "4.1.2",
    "cli-table3": "^0.6.5",
    "docker-cli-js": "^2.10.0",
    "dotenv": "^16.4.5",
    "inquirer": "8.2.6",
    "js-yaml": "^4.1.1",
    "ora": "^9.3.0",
    "viem": "^1.20.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/inquirer": "8.2.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "prettier": "^3.2.0",
    "solc": "^0.8.33",
    "tsx": "^4.23.0",
    "typescript": "5.3.2"
  }
}
